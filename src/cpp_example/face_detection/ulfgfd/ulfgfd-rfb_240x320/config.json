{
  "variant": "ulfgfd-rfb_240x320",
  "dxnn_file": "ulfgfd-rfb_240x320.dxnn",
  "task": "face_detection",
  "family": "ulfgfd",
  "input_width": 320,
  "input_height": 240,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_face.jpg",
  "default_video": "assets/videos/dance-group.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.3,
    "score_threshold": 0.5
  },
  "registry_config": {
    "score_threshold": 0.5,
    "nms_threshold": 0.3
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "ULFGPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
