{
  "variant": "ppmatting-hrnet-w48-distinctions_512x512",
  "dxnn_file": "ppmatting-hrnet-w48-distinctions_512x512.dxnn",
  "task": "image_matting",
  "family": "ppmatting",
  "input_width": 512,
  "input_height": 512,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_dog.jpg",
  "default_video": "assets/videos/blackbox-city-road.mp4",
  "zoo_canonical": false,
  "published": true,
  "config": {
    "alpha_threshold": 0.5,
    "checker_size": 16
  },
  "registry_config": {
    "alpha_threshold": 0.5
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "class": "SimpleResizePreprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "kwargs": {
      "mean_target": 110,
      "mean_target_above": 195
    },
    "config_overrides": {}
  },
  "postprocessor": {
    "class": "PPMattingPostprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "visualizer": {
    "class": "MattingVisualizer",
    "args": [
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "mean_target": 110,
  "mean_target_above": 195
}
