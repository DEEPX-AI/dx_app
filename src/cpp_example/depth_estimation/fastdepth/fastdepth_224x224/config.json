{
  "variant": "fastdepth_224x224",
  "dxnn_file": "fastdepth_224x224.dxnn",
  "task": "depth_estimation",
  "family": "fastdepth",
  "input_width": 224,
  "input_height": 224,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_parking.jpg",
  "default_video": "assets/videos/blackbox-city-road.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": true,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "DepthEstimationPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "DepthVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
