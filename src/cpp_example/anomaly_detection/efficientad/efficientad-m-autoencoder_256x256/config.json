{
  "variant": "efficientad-m-autoencoder_256x256",
  "dxnn_file": "efficientad-m-autoencoder_256x256.dxnn",
  "task": "anomaly_detection",
  "family": "efficientad",
  "input_width": 256,
  "input_height": 256,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_parking.jpg",
  "default_video": "assets/videos/blackbox-city-road.mp4",
  "zoo_canonical": false,
  "published": true,
  "config": {
    "roles": [
      "autoencoder",
      "student",
      "teacher"
    ]
  },
  "registry_config": {
    "roles": [
      "autoencoder",
      "student",
      "teacher"
    ]
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "class": "SimpleResizePreprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "postprocessor": {
    "class": "EfficientADPostprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "visualizer": {
    "class": "AnomalyVisualizer",
    "args": [],
    "kwargs": {},
    "config_overrides": {}
  }
}
