{
  "variant": "nanodet-repvgg-a_224x224",
  "dxnn_file": "nanodet-repvgg-a_224x224.dxnn",
  "task": "object_detection",
  "family": "nanodet",
  "input_width": 224,
  "input_height": 224,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/snowboard.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.45,
    "reg_max": 7,
    "score_threshold": 0.3
  },
  "registry_config": {
    "score_threshold": 0.3,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": true,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "NanoDetPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "DetectionVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
