{
  "variant": "ssd-mobilenetv1_300x300",
  "dxnn_file": "ssd-mobilenetv1_300x300.dxnn",
  "task": "object_detection",
  "family": "ssd",
  "input_width": 300,
  "input_height": 300,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/snowboard.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "has_background": true,
    "nms_threshold": 0.45,
    "num_classes": 20,
    "score_threshold": 0.3
  },
  "registry_config": {
    "score_threshold": 0.3,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": true,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "SSDPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "DetectionVisualizer",
    "config_overrides": {},
    "kwargs": {
      "label_set": "voc"
    }
  }
}
