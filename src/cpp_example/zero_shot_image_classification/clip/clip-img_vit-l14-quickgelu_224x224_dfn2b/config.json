  "input_width": 224,
  "input_height": 224,
  "image_only": true,
  "registry_image_only": true,
  "default_image": "sample/img/face_pair",
  "default_video": null,
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": false
  },
  "preprocessor": {
    "args": [
