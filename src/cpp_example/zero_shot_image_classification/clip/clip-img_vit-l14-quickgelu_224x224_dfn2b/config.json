        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {
      "mean": "<expr:[m * 255.0 for m in mean]>",
      "std": "<expr:[s * 255.0 for s in std]>"
    }
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "CLIPImagePostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "EmbeddingVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
