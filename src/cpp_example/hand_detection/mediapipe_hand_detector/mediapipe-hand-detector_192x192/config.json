{
  "variant": "mediapipe-hand-detector_192x192",
  "dxnn_file": "mediapipe-hand-detector_192x192.dxnn",
  "task": "hand_detection",
  "family": "mediapipe_hand_detector",
  "input_width": 192,
  "input_height": 192,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_person_a2.jpg",
  "default_video": "assets/videos/hand.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {
    "score_threshold": 0.5,
    "nms_threshold": 0.3
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {
      "pad_color": [
        0,
        0,
        0
      ]
    }
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "MediaPipeHandPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {
      "label": "Hand"
    }
  }
}
