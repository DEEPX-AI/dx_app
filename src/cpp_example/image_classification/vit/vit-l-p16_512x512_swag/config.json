{
  "variant": "vit-l-p16_512x512_swag",
  "dxnn_file": "vit-l-p16_512x512_swag.dxnn",
  "task": "image_classification",
  "family": "vit",
  "input_width": 512,
  "input_height": 512,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_dog.jpg",
  "default_video": "assets/videos/dogs.mp4",
  "zoo_canonical": false,
  "published": false,
  "config": {
    "top_k": 5
  },
  "registry_config": {
    "top_k": 5
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "class": "SimpleResizePreprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "postprocessor": {
    "class": "ClassificationPostprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "visualizer": {
    "class": "ClassificationVisualizer",
    "args": [],
    "kwargs": {},
    "config_overrides": {}
  }
}
