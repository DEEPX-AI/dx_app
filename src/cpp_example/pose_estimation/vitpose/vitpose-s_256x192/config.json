{
  "variant": "vitpose-s_256x192",
  "dxnn_file": "vitpose-s_256x192.dxnn",
  "task": "pose_estimation",
  "family": "vitpose",
  "input_width": 192,
  "input_height": 256,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_people.jpg",
  "default_video": "assets/videos/dance-solo.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {
      "normalize_float": true
    }
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "VitPosePostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "PoseVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
