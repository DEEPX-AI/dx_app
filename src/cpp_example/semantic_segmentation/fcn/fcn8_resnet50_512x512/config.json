{
  "variant": "fcn8_resnet50_512x512",
  "dxnn_file": "fcn8_resnet50_512x512.dxnn",
  "task": "semantic_segmentation",
  "family": "fcn",
  "input_width": 512,
  "input_height": 512,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_parking.jpg",
  "default_video": "assets/videos/blackbox-city-road.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "SemanticSegmentationPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "SemanticSegmentationVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
