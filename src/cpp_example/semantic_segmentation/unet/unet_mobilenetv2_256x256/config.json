{
  "variant": "unet_mobilenetv2_256x256",
  "dxnn_file": "unet_mobilenetv2_256x256.dxnn",
  "task": "semantic_segmentation",
  "family": "unet",
  "input_width": 256,
  "input_height": 256,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_parking.jpg",
  "default_video": "assets/videos/blackbox-city-road.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "SemanticSegmentationPostprocessor",
    "config_overrides": {
      "num_classes": 3
    },
    "kwargs": {
      "resize_to_original": false
    }
  },
  "visualizer": {
    "args": [],
    "class": "SemanticSegmentationVisualizer",
    "config_overrides": {},
    "kwargs": {
      "background_class": 1,
      "custom_palette": "<expr:_UNET_3CLASS_PALETTE>"
    }
  }
}
