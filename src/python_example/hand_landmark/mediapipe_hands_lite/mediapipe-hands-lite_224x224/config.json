{
  "variant": "mediapipe-hands-lite_224x224",
  "dxnn_file": "mediapipe-hands-lite_224x224.dxnn",
  "task": "hand_landmark",
  "family": "mediapipe_hands_lite",
  "input_width": 224,
  "input_height": 224,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_hand.jpg",
  "default_video": "assets/videos/hand.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "confidence_threshold": 0.3
  },
  "registry_config": {
    "confidence_threshold": 0.5
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "HandLandmarkPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "HandLandmarkVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
