{
  "variant": "scrfd-500m_640x640",
  "dxnn_file": "scrfd-500m_640x640.dxnn",
  "task": "face_detection",
  "family": "scrfd",
  "input_width": 640,
  "input_height": 640,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_face.jpg",
  "default_video": "assets/videos/dance-group.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.4,
    "score_threshold": 0.3
  },
  "registry_config": {
    "obj_threshold": 0.3,
    "score_threshold": 0.3,
    "nms_threshold": 0.4
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "SCRFDPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
