{
  "variant": "SCRFD500M_PPU",
  "dxnn_file": "SCRFD500M_PPU.dxnn",
  "task": "face_detection",
  "family": "scrfd",
  "input_width": 640,
  "input_height": 640,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/snowboard.mp4",
  "zoo_canonical": false,
  "published": true,
  "config": {
    "nms_threshold": 0.45,
    "score_threshold": 0.5
  },
  "registry_config": {
    "score_threshold": 0.5,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "SCRFDPPUPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
