{
  "variant": "yolov7-w6-face_1280x1280_tta",
  "dxnn_file": "yolov7-w6-face_1280x1280_tta.dxnn",
  "task": "face_detection",
  "family": "yolov7_face",
  "input_width": 1280,
  "input_height": 1280,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_face.jpg",
  "default_video": "assets/videos/dance-group.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.4,
    "obj_threshold": 0.3,
    "score_threshold": 0.45
  },
  "registry_config": {
    "obj_threshold": 0.3,
    "score_threshold": 0.3,
    "nms_threshold": 0.4
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "YOLOv5FacePostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
