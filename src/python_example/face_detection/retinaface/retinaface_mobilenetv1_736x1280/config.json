{
  "variant": "retinaface_mobilenetv1_736x1280",
  "dxnn_file": "retinaface_mobilenetv1_736x1280.dxnn",
  "task": "face_detection",
  "family": "retinaface",
  "input_width": 1280,
  "input_height": 736,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_face.jpg",
  "default_video": "assets/videos/dance-group.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {
    "score_threshold": 0.3,
    "nms_threshold": 0.4
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {
      "bgr": true,
      "mean": [
        104.0,
        117.0,
        123.0
      ],
      "nhwc": true
    }
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "RetinaFacePostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "FaceVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
