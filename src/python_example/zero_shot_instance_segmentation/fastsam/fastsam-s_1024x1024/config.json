{
  "variant": "fastsam-s_1024x1024",
  "dxnn_file": "fastsam-s_1024x1024.dxnn",
  "task": "zero_shot_instance_segmentation",
  "family": "fastsam",
  "input_width": 1024,
  "input_height": 1024,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/dogs.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.45,
    "score_threshold": 0.7
  },
  "registry_config": {
    "score_threshold": 0.4,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "YOLOv8InstanceSegPostprocessor",
    "config_overrides": {
      "nms_threshold": 0.65,
      "num_classes": 1,
      "score_threshold": 0.5
    },
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "InstanceSegVisualizer",
    "config_overrides": {},
    "kwargs": {
      "labels": [
        "segment"
      ],
      "show_boxes": false
    }
  }
}
