{
  "variant": "yolact_regnet-x1.6gf_512x512",
  "dxnn_file": "yolact_regnet-x1.6gf_512x512.dxnn",
  "task": "instance_segmentation",
  "family": "yolact",
  "input_width": 512,
  "input_height": 512,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/dogs.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.45,
    "num_classes": 81,
    "num_protos": 32,
    "score_threshold": 0.4,
    "top_k": 200
  },
  "registry_config": {
    "score_threshold": 0.4,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "YOLACTPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "InstanceSegVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
