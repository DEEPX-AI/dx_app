{
  "variant": "yolov12-seg-m_640x640",
  "dxnn_file": "yolov12-seg-m_640x640.dxnn",
  "task": "instance_segmentation",
  "family": "yolov12_seg",
  "input_width": 640,
  "input_height": 640,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/dogs.mp4",
  "zoo_canonical": false,
  "published": true,
  "config": {
    "score_threshold": 0.4,
    "nms_threshold": 0.5
  },
  "registry_config": {
    "score_threshold": 0.4,
    "nms_threshold": 0.5
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "class": "LetterboxPreprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "postprocessor": {
    "class": "YOLOv8InstanceSegPostprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "visualizer": {
    "class": "InstanceSegVisualizer",
    "args": [],
    "kwargs": {},
    "config_overrides": {}
  }
}
