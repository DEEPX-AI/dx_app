{
  "variant": "zerodce-pp_400x600",
  "dxnn_file": "zerodce-pp_400x600.dxnn",
  "task": "low_light_enhancement",
  "family": "zerodce",
  "input_width": 600,
  "input_height": 400,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_lowlight.jpg",
  "default_video": "assets/videos/lowlight.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {
      "normalize_float": true
    }
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "ZeroDCEPostprocessor",
    "config_overrides": {
      "num_iterations": 4
    },
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "EnhancementVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
