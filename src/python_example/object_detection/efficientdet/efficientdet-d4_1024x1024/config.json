{
  "variant": "efficientdet-d4_1024x1024",
  "dxnn_file": "efficientdet-d4_1024x1024.dxnn",
  "task": "object_detection",
  "family": "efficientdet",
  "input_width": 1024,
  "input_height": 1024,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_street.jpg",
  "default_video": "assets/videos/snowboard.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "nms_threshold": 0.45,
    "score_threshold": 0.4
  },
  "registry_config": {
    "score_threshold": 0.4,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "SimpleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "EfficientDetPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "DetectionVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
