{
  "variant": "yolo26-m-pose_640x640_pre-optimized",
  "dxnn_file": "yolo26-m-pose_640x640_pre-optimized.dxnn",
  "task": "pose_estimation",
  "family": "yolo_preopt_pose",
  "input_width": 640,
  "input_height": 640,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_people.jpg",
  "default_video": "assets/videos/dance-solo.mov",
  "zoo_canonical": false,
  "published": true,
  "config": {
    "score_threshold": 0.3,
    "nms_threshold": 0.45,
    "top_k": 300,
    "num_keypoints": 17
  },
  "registry_config": {
    "score_threshold": 0.3,
    "nms_threshold": 0.45,
    "top_k": 300,
    "num_keypoints": 17
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "class": "LetterboxPreprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "postprocessor": {
    "class": "PreoptPosePostprocessor",
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "kwargs": {},
    "config_overrides": {}
  },
  "visualizer": {
    "class": "PoseVisualizer",
    "args": [],
    "kwargs": {},
    "config_overrides": {}
  }
}
