{
  "variant": "yolo11-x-pose_640x640",
  "dxnn_file": "yolo11-x-pose_640x640.dxnn",
  "task": "pose_estimation",
  "family": "yolo11_pose",
  "input_width": 640,
  "input_height": 640,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_people.jpg",
  "default_video": "assets/videos/dance-solo.mov",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {
    "obj_threshold": 0.25,
    "score_threshold": 0.25,
    "nms_threshold": 0.45
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "YOLOv8PosePostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "PoseVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
