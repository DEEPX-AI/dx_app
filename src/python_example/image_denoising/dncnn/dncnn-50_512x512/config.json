{
  "variant": "dncnn-50_512x512",
  "dxnn_file": "dncnn-50_512x512.dxnn",
  "task": "image_denoising",
  "family": "dncnn",
  "input_width": 512,
  "input_height": 512,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_denoising.jpg",
  "default_video": "assets/videos/noisy_hand.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {},
  "registry_config": {},
  "cli": {
    "include_kitti_paths": false,
    "include_output": true,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "GrayscaleResizePreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "DnCNNPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "RestorationVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
