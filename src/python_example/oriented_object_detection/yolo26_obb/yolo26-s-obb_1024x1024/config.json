{
  "variant": "yolo26-s-obb_1024x1024",
  "dxnn_file": "yolo26-s-obb_1024x1024.dxnn",
  "task": "oriented_object_detection",
  "family": "yolo26_obb",
  "input_width": 1024,
  "input_height": 1024,
  "image_only": false,
  "registry_image_only": false,
  "default_image": "sample/img/sample_airport_satellite_view.png",
  "default_video": "assets/videos/obb.mp4",
  "zoo_canonical": true,
  "published": true,
  "config": {
    "score_threshold": 0.3
  },
  "registry_config": {
    "score_threshold": 0.3
  },
  "cli": {
    "include_kitti_paths": false,
    "include_output": false,
    "include_stream_inputs": true
  },
  "preprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      }
    ],
    "class": "LetterboxPreprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "postprocessor": {
    "args": [
      {
        "token": "input_width"
      },
      {
        "token": "input_height"
      },
      {
        "token": "config"
      }
    ],
    "class": "OBBPostprocessor",
    "config_overrides": {},
    "kwargs": {}
  },
  "visualizer": {
    "args": [],
    "class": "OBBVisualizer",
    "config_overrides": {},
    "kwargs": {}
  }
}
